# Copie este arquivo para .env e preencha com as credenciais do projeto
# Firebase (Console do Firebase > Configurações do projeto > Seus apps).
# Um único projeto Firebase atende todas as barbearias.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Slug da barbearia (id do documento em tenants/{slug}) que este deploy
# representa. Em produção, cada barbearia tem seu próprio projeto Vercel
# com essa variável preenchida — o app já nasce travado naquela barbearia,
# sem precisar de slug na URL. Obrigatória: sem ela o app mostra um aviso
# de "barbearia não configurada". Em dev local, preencha com o slug de teste.
VITE_TENANT_SLUG=
